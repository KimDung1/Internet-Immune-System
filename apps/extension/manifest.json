{
  "manifest_version": 3,
  "name": "Internet Immune System — Realtime Cyber Shield",
  "version": "1.0.0",
  "description": "AI Experience bảo vệ bạn khỏi web lừa đảo và giả mạo bằng Google Gemini AI.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/dom-shield.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*.immune-system.vn/*"
  ]
}
