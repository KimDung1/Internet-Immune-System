# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration (Cloud Run API)
FIREBASE_PROJECT_ID=internet-immune-system
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@internet-immune-system.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK Configuration (Next.js Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=internet-immune-system.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=internet-immune-system
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=internet-immune-system.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# API Gateway URL
NEXT_PUBLIC_API_URL=http://localhost:8080
